<lg><pb n="2r"/> <!-- F.002r -->
<l n="a"><lb n="2r1"/>hram̐ <app><lem wit="#edSS">hrim̐</lem><rdg wit="#J1">hram̐</rdg></app> <app><lem wit="#edSS">hrum̐</lem><rdg wit="#J1">hrūm̐</rdg></app> <app><lem wit="#edSS">lambajihve</lem><rdg wit="#J1">lambhajīye</rdg></app> <app><lem wit="#J1">ka ka ka ka ka ka goye</lem><rdg wit="#edSS">khagakhagakhagaje</rdg></app> <app><lem wit="#edSS">ehi ehi</lem><rdg wit="#J1">hi he hi</rdg></app> pracaṇḍe|</l>
<l n="b"><app><lem wit="#J1">jhram̐ jhrim̐ jhrūm̐</lem><rdg>jram̐ jrim̐ jrum̐</rdg></app>
	<app><lem wit="#edSS">khaḍgadhāre</lem><rdg wit="#J1">padmadāre</rdg></app> ra ra ra ra ra ra
